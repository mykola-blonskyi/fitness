# Copy to ~/backup/.env on the host, chmod 600. Values unquoted: docker --env-file reads this file too.

# MinIO user with list and read access to fitness-progress-photos only.
RCLONE_CONFIG_MINIO_TYPE=s3
RCLONE_CONFIG_MINIO_PROVIDER=Minio
RCLONE_CONFIG_MINIO_ENDPOINT=http://minio:9000
RCLONE_CONFIG_MINIO_ACCESS_KEY_ID=
RCLONE_CONFIG_MINIO_SECRET_ACCESS_KEY=

# Same bot and chat as ~/uptime-check/.env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
