# Same shared Postgres instance as backend/.env.example - this worker
# writes detection results directly to this project's own tables.
DATABASE_URL=postgresql://user:password@localhost:5432/fitness

# Cross-language photo-analysis job queue (docs/decisions.md ADR-003).
REDIS_URL=redis://localhost:6379

# Own MinIO credentials, separate from the backend's - see
# knowledge/business-rules.md "Python worker accesses MinIO directly, not
# via presigned URLs".
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=fitness-progress-photos
