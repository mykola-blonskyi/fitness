# login.blonskyi.dev's issuer URL (no trailing slash) — OIDC discovery
# reads {OIDC_ISSUER}/.well-known/openid-configuration from it.
OIDC_ISSUER=https://login.blonskyi.dev

# The `fitness` client's secret, as registered with login's register-client.
OIDC_CLIENT_SECRET=

# This app's own Auth.js secret — signs this app's own session cookie and
# is deliberately NOT shared with any other *.blonskyi.dev app.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# This app's own public origin (no trailing slash) — used to build absolute
# URLs (e.g. the sign-in callbackUrl) instead of trusting request.url, which
# resolves to the container's internal bind address behind Coolify/Traefik.
APP_URL=http://localhost:3000

# Hub base URL (no trailing slash) — only the nav rail's "open the hub"
# link; no longer part of authentication.
HUB_URL=https://blonskyi.dev

# Internal-only backend endpoint (ADR-001) — Docker service DNS name in
# prod (http://backend:3001), localhost in local dev
BACKEND_URL=http://localhost:3001

# Sentry error tracking (see docs/decisions.md ADR-006) — NEXT_PUBLIC_
# prefix is required even though this app has no other public runtime
# config, since Next.js inlines it into the browser bundle at build time.
# Only active when NODE_ENV=production, so this can stay unset locally.
NEXT_PUBLIC_SENTRY_DSN=

# Build-only (source map upload) — never needed at container runtime.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
