# Shared Postgres instance (see docs/architecture.md — this project's own tables only)
DATABASE_URL=postgresql://user:password@localhost:5432/fitness

PORT=3001

# Sentry error tracking (see docs/decisions.md ADR-006) — only used when
# NODE_ENV=production, so this can stay unset for local development.
SENTRY_DSN=

# Only used by `pnpm db:seed:food-catalog` (FITNESS-27) — free self-service
# keys, get your own at https://api.nal.usda.gov/signup and
# https://www.deepl.com/pro-api. Both are optional: the script skips that
# part of the import (with a warning) when unset.
USDA_API_KEY=
DEEPL_API_KEY=

# Progress photos (docs/decisions.md ADR-002) — must resolve to a host the
# browser can also reach directly, since presigned PUT/GET URLs are handed
# straight to the client. The private bucket itself is provisioned out of
# band, same as the Hub's project_access grant.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=fitness-progress-photos

# Cross-language photo-analysis job queue (docs/decisions.md ADR-003) - a
# plain Redis list, shared with the Python worker (see worker/.env.example).
REDIS_URL=redis://localhost:6379
