# Shared Postgres instance (see docs/architecture.md — this project's own tables only)
DATABASE_URL=postgresql://user:password@localhost:5432/fitness

PORT=3001

# Sentry error tracking (see docs/decisions.md ADR-006) — only used when
# NODE_ENV=production, so this can stay unset for local development.
SENTRY_DSN=

# Only used by `pnpm db:seed:food-catalog` (FITNESS-27) — free self-service
# keys, get your own at https://api.nal.usda.gov/signup and
# https://www.deepl.com/pro-api. Both are optional: the script skips that
# part of the import (with a warning) when unset.
USDA_API_KEY=
DEEPL_API_KEY=
